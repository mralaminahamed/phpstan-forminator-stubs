    {
        /** @var HandlerInterface */
        private $handler;
        /** @var int[] */
        private $thresholdMap = [\ForminatorGoogleAddon\Monolog\Logger::DEBUG => 0, \ForminatorGoogleAddon\Monolog\Logger::INFO => 0, \ForminatorGoogleAddon\Monolog\Logger::NOTICE => 0, \ForminatorGoogleAddon\Monolog\Logger::WARNING => 0, \ForminatorGoogleAddon\Monolog\Logger::ERROR => 0, \ForminatorGoogleAddon\Monolog\Logger::CRITICAL => 0, \ForminatorGoogleAddon\Monolog\Logger::ALERT => 0, \ForminatorGoogleAddon\Monolog\Logger::EMERGENCY => 0];
