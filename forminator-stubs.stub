         * @param array $mapping
         * @param int $idx
         * @param array $special
         * @return string
         */
        private static function encode_der($source, array $mapping, $idx = null, array $special = [])
        {
        }
        /**
         * BER-decode the OID
         *
         * Called by _decode_ber()
         *
         * @param string $content
         * @return string
         */
        public static function decodeOID($content)
